{
  "name": "printvault-3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node electron/dev-runner.js",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron .",
    "build:win": "npm run build && electron-builder --win",
    "web:build": "cross-env VITE_WEB_ONLY=true vite build",
    "server": "node server/index.mjs",
    "server:dev": "node --watch server/index.mjs",
    "web:start": "npm run web:build && npm run server",
    "docker:build": "docker build -t printvault3d .",
    "docker:up": "docker compose up --build",
    "reinstall": "rimraf node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "express": "^4.22.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.183.2"
  },
  "build": {
    "appId": "com.printvault3d.app",
    "productName": "PrintVault3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.8",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
